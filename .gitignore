
# ==========================================
# Dependencies
# ==========================================
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ==========================================
# Environment variables and API secrets
# ==========================================
.env
.env.*
.env*.local
**/.env
**/.env.*
**/.env*.local

# Allow safe example files only
!.env.example
!.env.*.example
!**/.env.example
!**/.env.*.example

# ==========================================
# Python virtual environments
# ==========================================
.venv/
venv/
ENV/
env/

# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Python packaging and build artifacts
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg

# ==========================================
# SQLite databases and backups
# ==========================================
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-*

# ==========================================
# Next.js and frontend build output
# ==========================================
.next/
out/
/build
.vercel/
*.tsbuildinfo
next-env.d.ts

# ==========================================
# Testing and coverage
# ==========================================
coverage/
.pytest_cache/
htmlcov/
.coverage
.coverage.*

# ==========================================
# Logs and debugging
# ==========================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ==========================================
# Operating system files
# ==========================================
.DS_Store
Thumbs.db
Desktop.ini

# ==========================================
# IDE and editor settings
# ==========================================
.vscode/
.idea/
*.swp
*.swo

# ==========================================
# Certificates and private keys
# ==========================================
*.pem
*.key
