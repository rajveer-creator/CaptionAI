# Groq API Configuration
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_TOKENS=1024

# Supabase Project Configuration
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_or_anon_key

# Optional: Allowed CORS Origins
# Note: localhost:3000, 127.0.0.1:3000, and https://*.vercel.app are automatically allowed.
# For custom domains, add comma-separated origins:
# CORS_ORIGINS=https://yourdomain.com
# CORS_ORIGIN_REGEX=^https:\/\/.*\.vercel\.app$
