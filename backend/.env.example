# Groq API Configuration
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_TOKENS=1024

# Supabase Project Configuration
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_or_anon_key

# Optional: Allowed CORS Origins (comma-separated, localhost:3000 and 127.0.0.1:3000 are always preserved)
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://yourdomain.com
